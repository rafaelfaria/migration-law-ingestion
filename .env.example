# Copy this file to .env and replace the placeholder values with those on the
# Neo4j Aura instance's Connect page. Never commit .env or share its password.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-generated-password
NEO4J_DATABASE=neo4j
